<Window x:Class="NFOForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NFOForge 1.0.0 — Guidessence"
        Closing="Window_Closing"
        Height="800" Width="1350" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProjectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral : navigation préservée. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20">
                    <TextBlock Text="NFOForge 1.0.0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="© 2026 Guidessence"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,5,0,10"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Margin="20,30,20,35">
                        <TextBlock Text="NFOFORGE" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="NFO &amp; BBCode Studio" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Content="⌂  Tableau de bord"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <!-- Cette entrée reste la page existante ; le bouton de barre d'outils crée le projet. -->
                    <Button Content="▣  Nouveau projet"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="NewProject"/>
                    <Button Content="≡  Métadonnées"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="Metadata"/>
                    <Button Content="✓  Conformité"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="Compliance"/>
                    <Button Content="▤  Génération NFO"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="NFO"/>
                    <Button Content="▦  Génération BBCode"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="BBCode"/>
                    <Button Content="◉  Prévisualisation"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="Preview"/>
                    <Separator Margin="20,20"/>
                    <Button Content="⚙  Paramètres"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    <Button Content="ⓘ  À propos"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateCommand}" CommandParameter="About"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="35,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Commandes projet : binding sur MainViewModel. -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                    CornerRadius="10" Padding="12" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Left">
                        <Button Content="＋ Nouveau" ToolTip="Nouveau projet (Ctrl+N)"
                                Style="{StaticResource ProjectButtonStyle}"
                                Command="{Binding NewProjectCommand}"/>
                        <Button Content="📂 Ouvrir" ToolTip="Ouvrir un projet (Ctrl+O)"
                                Style="{StaticResource ProjectButtonStyle}"
                                Command="{Binding OpenProjectCommand}"/>
                        <Button Content="💾 Enregistrer" ToolTip="Enregistrer le projet (Ctrl+S)"
                                Style="{StaticResource ProjectButtonStyle}"
                                Command="{Binding SaveProjectCommand}"/>
                        <Button Content="Enregistrer sous" ToolTip="Enregistrer sous (Ctrl+Maj+S)"
                                Style="{StaticResource ProjectButtonStyle}"
                                Command="{Binding SaveProjectAsCommand}"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <Border Grid.Row="2" Margin="0,20,0,0" Padding="10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="Guidessence © 2026"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ProjectStatus, FallbackValue=NFOForge — Prêt}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource AccentBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
