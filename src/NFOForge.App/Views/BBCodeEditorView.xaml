<UserControl x:Class="NFOForge.App.Views.BBCodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Éditeur BBCode" FontSize="30" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Générez des descriptions BBCode à partir des métadonnées."
                       Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource AccentBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding CharacterCount, StringFormat='Caractères : {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding LineCount, StringFormat='   |   Lignes : {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding DocumentState}" Margin="16,0,0,0"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                Padding="12" Margin="0,0,0,10">
            <WrapPanel>
                <ComboBox Width="160" ItemsSource="{Binding AvailableTemplates}"
                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,10,8"/>
                <Button Content="Générer" Command="{Binding GenerateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Importer" Command="{Binding ImportCommand}" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Exporter TXT" Command="{Binding ExportCommand}" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Copier" Command="{Binding CopyCommand}" Padding="12,7" Margin="0,0,8,8"/>
                <Button Content="Valider" Command="{Binding ValidateCommand}" Padding="12,7" Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10"
                Padding="10" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="[b] Gras" Command="{Binding InsertBoldCommand}" Padding="10,5" Margin="0,0,8,5"/>
                <Button Content="[i] Italique" Command="{Binding InsertItalicCommand}" Padding="10,5" Margin="0,0,8,5"/>
                <Button Content="[color] Couleur" Command="{Binding InsertColorCommand}" Padding="10,5" Margin="0,0,8,5"/>
                <Button Content="[url] Lien" Command="{Binding InsertUrlCommand}" Padding="10,5" Margin="0,0,8,5"/>
                <Button Content="[img] Image" Command="{Binding InsertImageCommand}" Padding="10,5" Margin="0,0,8,5"/>
            </WrapPanel>
        </Border>
        <Expander Grid.Row="3" Header="Bibliothèque de modèles BBCode personnalisés"
                  Background="{StaticResource CardBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Margin="0,0,0,10" Padding="8" IsExpanded="False">
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding TemplateState}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Nom du modèle" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,10" Padding="8"/>
                    <TextBlock Text="Contenu et variables : {Nom}, {Version}, {Description}..."
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding TemplateContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="115" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Margin="0,5,0,10"/>
                    <!-- Champs associés aux variables d'images : aucun téléchargement -->
                    <TextBlock Text="URL de l'affiche (POSTER_URL)"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                    <TextBox Text="{Binding PosterUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" Margin="0,0,0,8"/>
                    <TextBlock Text="URL de la capture (SCREENSHOT_URL)"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ScreenshotUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" Margin="0,0,0,10"/>
                    <TextBlock Text="Variables personnalisées détectées dans ce modèle"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding CustomVariables}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Padding="7"
                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Nouveau" Command="{Binding NewTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="Enregistrer le modèle" Command="{Binding SaveTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="Supprimer" Command="{Binding DeleteTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="Prévisualiser" Command="{Binding PreviewTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="Importer JSON" Command="{Binding ImportTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                        <Button Content="Exporter JSON" Command="{Binding ExportTemplateCommand}" Padding="12,7" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="Résultat BBCode du modèle (code brut)"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding TemplatePreview, Mode=OneWay}" Height="100"
                             IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Code BBCode" FontSize="16"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding BBCodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="13" Background="#101827" Foreground="White"
                             CaretBrush="#00C8FF" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Prévisualisation BBCode"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationMessage}"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <FlowDocumentScrollViewer Document="{Binding PreviewDocument}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="#101827"
                                              BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
