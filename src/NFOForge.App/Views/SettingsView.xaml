<UserControl x:Class="NFOForge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <TextBlock Text="Paramètres"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Configuration générale de NFOForge"
                       FontSize="13"
                       Foreground="#9DB1CF"
                       Margin="0,0,0,30"/>

            <Border Background="#172338"
                    BorderBrush="#263752"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="MISES À JOUR"
                               Foreground="#00BFFF"
                               FontWeight="Bold"
                               FontSize="20"
                               Margin="0,0,0,24"/>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Version installée"
                                       Foreground="#9DB1CF"/>

                            <TextBlock Text="{Binding InstalledVersion}"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Version publiée"
                                       Foreground="#9DB1CF"/>

                            <TextBlock Text="{Binding PublishedVersion}"
                                       Foreground="#00BFFF"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#30415D"
                               Margin="0,0,0,22"/>

                    <TextBlock Text="{Binding Status}"
                               Foreground="White"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Dernière vérification"
                               Foreground="#9DB1CF"/>

                    <TextBlock Text="{Binding LastCheck}"
                               Foreground="White"
                               Margin="0,5,0,22"/>

                    <CheckBox Content="Vérifier automatiquement les mises à jour au démarrage"
                          IsChecked="{Binding CheckOnStartup, Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                          Foreground="White"
                          FontSize="13"
                          Margin="0,0,0,22"
                          VerticalAlignment="Center"/>

                    <Button Content="↻  Rechercher les mises à jour"
                            Command="{Binding CheckUpdatesCommand}"
                            HorizontalAlignment="Left"
                            Padding="18,12"
                            Background="#007BFF"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBlock Text="La recherche utilise le serveur HTTPS officiel de Guidessence. Aucune installation n'est lancée automatiquement."
                               Foreground="#9DB1CF"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,22,0,0"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
