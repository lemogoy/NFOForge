<UserControl x:Class="NFOForge.App.Views.NfoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- EN-TÊTE -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Éditeur NFO"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Text="Créez, modifiez et prévisualisez vos fichiers NFO."
                       Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding CharacterCount, StringFormat='Caractères : {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"/>

                <TextBlock Text="{Binding LineCount, StringFormat='  |  Lignes : {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"/>

                <TextBlock Text="{Binding DocumentState}"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="18,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- BARRE D'OUTILS -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">
            <WrapPanel>
                <TextBlock Text="Modèle :"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,7,8"/>

                <ComboBox Width="140"
                          SelectedItem="{Binding SelectedTemplate}"
                          ItemsSource="{Binding AvailableTemplates}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,8"/>

                <Button Content="Générer"
                        Command="{Binding GenerateCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="15,9"
                        Margin="0,0,8,8"/>

                <Button Content="Importer"
                        Command="{Binding ImportCommand}"
                        Padding="15,9"
                        Margin="0,0,8,8"/>

                <Button Content="Exporter"
                        Command="{Binding ExportCommand}"
                        Padding="15,9"
                        Margin="0,0,8,8"/>

                <Button Content="Copier"
                        Command="{Binding CopyCommand}"
                        Padding="15,9"
                        Margin="0,0,15,8"/>

                <ComboBox Width="170"
                          SelectedItem="{Binding SelectedEncoding}"
                          ItemsSource="{Binding AvailableEncodings}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>



        <!-- BIBLIOTHÈQUE DE MODÈLES -->
        <Expander Grid.Row="2"
          Header="Bibliothèque de modèles personnalisés"
          Background="{StaticResource CardBrush}"
          Foreground="{StaticResource TextPrimaryBrush}"
          Margin="0,0,0,12"
          Padding="10"
          IsExpanded="False">

            <StackPanel Margin="8">
                <TextBlock Text="Nom du modèle"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBox Text="{Binding TemplateName, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5,0,10"
                 Padding="8"/>

                <TextBlock Text="Contenu du modèle et variables"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBox Text="{Binding TemplateContent, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                 Height="130"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="0,5,0,10"/>

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Nouveau"
                    Command="{Binding NewTemplateCommand}"
                    Padding="12,7"
                    Margin="0,0,8,8"/>

                    <Button Content="Enregistrer le modèle"
                    Command="{Binding SaveTemplateCommand}"
                    Padding="12,7"
                    Margin="0,0,8,8"/>

                    <Button Content="Supprimer"
                    Command="{Binding DeleteTemplateCommand}"
                    Padding="12,7"
                    Margin="0,0,8,8"/>

                    <Button Content="Prévisualiser"
                    Command="{Binding PreviewTemplateCommand}"
                    Padding="12,7"
                    Margin="0,0,8,8"/>
                </WrapPanel>

                <TextBlock Text="Résultat du modèle"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,6"/>

                <TextBox Text="{Binding TemplatePreview, Mode=OneWay}"
                 Height="120"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Expander>

        <!-- ÉDITEUR ET PRÉVISUALISATION -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ÉDITEUR -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Contenu NFO"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12"/>

                    <TextBox Text="{Binding NfoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="#101827"
                             Foreground="White"
                             CaretBrush="#00C8FF"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             SpellCheck.IsEnabled="False"/>
                </DockPanel>
            </Border>

            <!-- PRÉVISUALISATION -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Prévisualisation"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12"/>

                    <TextBox Text="{Binding NfoText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="#101827"
                             Foreground="#00C8FF"
                             BorderThickness="0"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             SpellCheck.IsEnabled="False"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


