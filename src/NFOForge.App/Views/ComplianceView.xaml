<UserControl
    x:Class="NFOForge.App.Views.ComplianceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Contrôle de conformité"
                FontSize="30"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock
                Text="Analyse des logiciels selon le référentiel C411."
                Margin="0,10,0,0"
                Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>

        <!-- CONTENU -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,20">

                <!-- PROFIL -->

                <Border
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock
                            Text="Profil de publication"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="C411 — Applications / Logiciels"
                            FontSize="16"
                            Margin="0,15,0,0"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,15,0,0">

                            <TextBlock
                                Text="Version du référentiel : "
                                Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock
                                Text="{Binding RuleVersion, Mode=OneWay}"
                                Foreground="{StaticResource TextPrimaryBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- RÉSULTAT -->
                <!-- INVENTAIRE DE LA RELEASE -->

                <Border Background="{StaticResource CardBrush}"
        CornerRadius="12"
        Padding="25"
        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Inventaire de la release"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,15"/>


                        <!-- COMMANDES DE L'INVENTAIRE -->

                        <StackPanel Orientation="Horizontal">

                            <!-- Sélection du dossier -->

                            <Button
                                Content="📁  Parcourir un dossier"
                                Command="{Binding BrowseFolderCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,10"
                                Margin="0,0,12,0"
                                Cursor="Hand"/>

                            <!-- Annulation de l'analyse -->

                            <Button
                                Content="✕  Annuler l'analyse"
                                Command="{Binding CancelInventoryCommand}"
                                Background="#42202A"
                                Foreground="#FFB4B4"
                                BorderBrush="#A94455"
                                BorderThickness="1"
                                Padding="15,10"
                                Cursor="Hand"
                                IsEnabled="True"/>

                        </StackPanel>


                        <TextBlock Text="{Binding SelectedFolder, Mode=OneWay}"
                   Margin="0,15,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{Binding InventorySummary, Mode=OneWay}"
                   Margin="0,10,0,15"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- PROGRESSION DE L'INVENTAIRE SHA-256 -->

                        <StackPanel Margin="0,0,0,20">

                            

                            <!-- Texte de progression -->

                            <TextBlock
                    Text="{Binding InventoryProgressText, Mode=OneWay}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>

                                        <!-- Barre de progression -->

                                        <ProgressBar
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding InventoryProgressPercentage, Mode=OneWay}"
                    Height="12"
                    Foreground="{StaticResource AccentBrush}"
                    Background="{StaticResource SidebarBrush}"/>

                                        <!-- Pourcentage -->

                                        <TextBlock
                    Text="{Binding InventoryProgressPercentage,
                                   Mode=OneWay,
                                   StringFormat='{}{0}%'}"
                    Foreground="{StaticResource AccentBrush}"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"/>

                        </StackPanel>

                        <TextBlock Text="Fichiers détectés"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding InventoryFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Avertissements d'inventaire"
                   FontWeight="SemiBold"
                   Foreground="#FFB86C"
                   Margin="0,20,0,10"/>

                        <ItemsControl ItemsSource="{Binding InventoryWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               Foreground="#FFB86C"
                               Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Border>
                
                <Border
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock
                            Text="Résultat du contrôle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="{Binding Status, Mode=OneWay}"
                            FontSize="25"
                            FontWeight="Bold"
                            Margin="0,20,0,10"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            Text="{Binding Details, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- COMMANDES DU CONTRÔLE -->

                        <StackPanel Orientation="Horizontal"
                            Margin="0,25,0,0">

                            <!-- Analyse -->

                            <Button
                                Content="✓  Vérifier"
                                Command="{Binding VerifyCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="20,12"
                                Margin="0,0,12,0"
                                Cursor="Hand"/>

                            <!-- Export du rapport -->

                            <Button
                                Content="↓  Exporter le rapport"
                                Command="{Binding ExportReportCommand}"
                                Background="{StaticResource SidebarBrush}"
                                Foreground="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Padding="20,12"
                                Cursor="Hand"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- ANOMALIES -->

                <Border
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="25">

                    <StackPanel>

                        <TextBlock
                            Text="Anomalies et vérifications"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Margin="0,0,0,20"/>

                        <ItemsControl
                            ItemsSource="{Binding Findings}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Background="{StaticResource SidebarBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,8">

                                        <TextBlock
                                            Text="{Binding}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>