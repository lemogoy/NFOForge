<UserControl x:Class="NFOForge.App.Views.MetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <!-- Champs de saisie -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#26374F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00C8FF"/>
        </Style>

        <!-- Libellés -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

 
        <!-- MENUS DÉROULANTS SOMBRES -->

        <!-- MENUS DÉROULANTS NFOFORGE -->

        <Style TargetType="{x:Type ComboBox}"
       BasedOn="{StaticResource NFOForgeComboBoxStyle}"/>

        
        <!-- Titres des sections -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->

        <StackPanel Grid.Row="0" Margin="0,0,0,20">

            <TextBlock Text="Métadonnées"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock
                Text="Renseignez les informations nécessaires à la création de votre fiche."
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,8,0,0"/>

        </StackPanel>

        <!-- FORMULAIRE DÉFILANT -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,0,12,20">
                <!-- VALIDATION DES MÉTADONNÉES -->

                <Border Background="{StaticResource CardBrush}"
        CornerRadius="12"
        Padding="25"
        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Contrôle des informations"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding ValidationStatus, Mode=OneWay}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   Margin="0,0,0,10"/>

                        <!-- Barre de progression -->

                        <ProgressBar Minimum="0"
                     Maximum="100"
                     Value="{Binding CompletionPercentage, Mode=OneWay}"
                     Height="12"
                     Foreground="{StaticResource AccentBrush}"
                     Background="{StaticResource SidebarBrush}"
                     Margin="0,0,0,10"/>

                        <TextBlock FontSize="14"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,20">

            <Run Text="Complétude : "/>

            <Run Text="{Binding CompletionPercentage, Mode=OneWay}"/>

            <Run Text="%"/>

                        </TextBlock>

                        <!-- Liste des anomalies -->

                        <ItemsControl ItemsSource="{Binding ValidationErrors}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding}"
                               Foreground="#FFB86C"
                               TextWrapping="Wrap"
                               Margin="0,3"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- Bouton de vérification -->

                        <Button Content="✓  Vérifier les informations"
                Command="{Binding ValidateCommand}"
                Background="{StaticResource PrimaryBrush}"
                Foreground="White"
                BorderThickness="0"
                Padding="15,10"
                HorizontalAlignment="Left"
                Margin="0,20,0,0"
                Cursor="Hand"/>

                    </StackPanel>

                </Border>

                <!-- IDENTIFICATION -->

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="01 — Identification du logiciel"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Nom du logiciel"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Version"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Éditeur"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Développeur"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"/>

                    </StackPanel>

                </Border>

                <!-- CLASSIFICATION -->


                <!-- CLASSIFICATION -->

                <Border Background="{StaticResource CardBrush}"
        CornerRadius="12"
        Padding="25"
        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="02 — Classification"
                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- Catégorie -->

                        <TextBlock Text="Catégorie"
                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox
            ItemsSource="{Binding AvailableCategories}"
            SelectedItem="{Binding Category, Mode=TwoWay}"
            Margin="0,0,0,15"/>

                        <!-- Sous-catégorie -->

                        <TextBlock Text="Sous-catégorie"
                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox
            ItemsSource="{Binding AvailableSubcategories}"
            SelectedItem="{Binding Subcategory, Mode=TwoWay}"
            Margin="0,0,0,15"/>

                        <!-- Profil de publication -->

                        <TextBlock Text="Profil de publication"
                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox
            ItemsSource="{Binding AvailableProfiles}"
            SelectedItem="{Binding PublicationProfile, Mode=TwoWay}"
            Margin="0,0,0,12"/>

                        <!-- Information sur le référentiel -->

                        <TextBlock
            Text="{Binding ProfileInformation, Mode=OneWay}"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"
            FontSize="12"
            Margin="0,0,0,5"/>

                    </StackPanel>

                </Border>

                <!-- INFORMATIONS TECHNIQUES -->

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="03 — Informations techniques"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Système d'exploitation"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox SelectedValue="{Binding OperatingSystem, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Margin="0,0,0,15">

                            <ComboBoxItem Content="Windows"/>
                            <ComboBoxItem Content="Linux"/>
                            <ComboBoxItem Content="macOS"/>

                        </ComboBox>

                        <TextBlock Text="Architecture"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox SelectedValue="{Binding Architecture, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Margin="0,0,0,15">

                            <ComboBoxItem Content="x64"/>
                            <ComboBoxItem Content="x86"/>
                            <ComboBoxItem Content="ARM64"/>
                            <ComboBoxItem Content="Multiplateforme"/>

                        </ComboBox>

                        <TextBlock Text="Langue"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox SelectedValue="{Binding Language, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Margin="0,0,0,15">

                            <ComboBoxItem Content="FR"/>
                            <ComboBoxItem Content="EN"/>
                            <ComboBoxItem Content="MULTI"/>
                            <ComboBoxItem Content="FR/EN"/>

                        </ComboBox>

                        <TextBlock Text="Date de sortie"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <!-- DATE DE SORTIE -->

                        <DatePicker
                            SelectedDate="{Binding ReleaseDate, Mode=TwoWay}"
                            Style="{StaticResource NFOForgeDatePickerStyle}"
                            Language="fr-FR"/>

                               
                    </StackPanel>

                </Border>

                <!-- DESCRIPTION -->

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="04 — Présentation générale"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Description"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Height="130"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Fonctionnalités"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding Features, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Height="110"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Informations complémentaires"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Text="{Binding AdditionalInformation, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Height="100"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>