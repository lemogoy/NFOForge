<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PALETTE NFOFORGE -->
    <SolidColorBrush x:Key="CalendarBackgroundBrush"
                 Color="#101827"/>

    <SolidColorBrush x:Key="CalendarHeaderBrush"
                 Color="#172235"/>

    <SolidColorBrush x:Key="CalendarForegroundBrush"
                 Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CalendarAccentBrush"
                 Color="#00C8FF"/>

    <SolidColorBrush x:Key="CalendarSelectedBrush"
                 Color="#007BFF"/>

    <SolidColorBrush x:Key="CalendarBorderBrush"
                 Color="#26374F"/>
    <!-- Champ de saisie du DatePicker -->
    <Style x:Key="NFOForgeDatePickerTextBoxStyle"
           TargetType="{x:Type DatePickerTextBox}">

        <Setter Property="Background" Value="#101827"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#26374F"/>
        <Setter Property="CaretBrush" Value="#00C8FF"/>
        <Setter Property="Padding" Value="10,6"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">

                    <Border
                        x:Name="TextBoxBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0">

                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ======================================== -->
    <!-- NFOFORGE - JOURS DU CALENDRIER           -->
    <!-- ======================================== -->

    <Style x:Key="NFOForgeCalendarDayStyle"
       TargetType="{x:Type CalendarDayButton}">

        <Setter Property="Background" Value="#101827"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="28"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type CalendarDayButton}">

                    <Border x:Name="DayBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Margin="1">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Survol -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="DayBorder"
                                Property="Background"
                                Value="#174578"/>

                        </Trigger>

                        <!-- Jour sélectionné -->
                        <Trigger Property="IsSelected"
                             Value="True">

                            <Setter TargetName="DayBorder"
                                Property="Background"
                                Value="#007BFF"/>

                            <Setter Property="Foreground"
                                Value="White"/>

                        </Trigger>

                        <!-- Jour actuel -->
                        <Trigger Property="IsToday"
                             Value="True">

                            <Setter TargetName="DayBorder"
                                Property="BorderBrush"
                                Value="#00C8FF"/>

                        </Trigger>

                        <!-- Jours hors du mois courant -->
                        <Trigger Property="IsInactive"
                             Value="True">

                            <Setter Property="Foreground"
                                Value="#64748B"/>

                        </Trigger>

                        <!-- Dates indisponibles -->
                        <Trigger Property="IsBlackedOut"
                             Value="True">

                            <Setter Property="Foreground"
                                Value="#64748B"/>

                            <Setter Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                        <!-- Désactivation -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter Property="Opacity"
                                Value="0.4"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!-- Boutons de navigation du calendrier -->
    <Style x:Key="NFOForgeCalendarNavigationButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CalendarAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="#26374F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boutons des années et des mois -->
    <Style x:Key="NFOForgeCalendarButtonStyle"
           TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#101827"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Border x:Name="Cell" Margin="2" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="#174578"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#64748B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem : structure du calendrier en thème sombre -->
    <Style x:Key="NFOForgeCalendarItemStyle"
           TargetType="{x:Type CalendarItem}">
        <Setter Property="Background" Value="{StaticResource CalendarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CalendarForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- En-tête : mois/année et navigation -->
                            <Grid Grid.Row="0" Background="{StaticResource CalendarHeaderBrush}"
                                  Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                        Style="{StaticResource NFOForgeCalendarNavigationButtonStyle}"
                                        Content="◀" AutomationProperties.Name="Mois précédent"/>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                        Style="{StaticResource NFOForgeCalendarNavigationButtonStyle}"
                                        FontWeight="SemiBold" Foreground="White"
                                        AutomationProperties.Name="Choisir le mois ou l'année"/>
                                <Button x:Name="PART_NextButton" Grid.Column="2"
                                        Style="{StaticResource NFOForgeCalendarNavigationButtonStyle}"
                                        Content="▶" AutomationProperties.Name="Mois suivant"/>
                            </Grid>

                            <!-- Vue mensuelle : sept colonnes et sept lignes -->
                            <Grid x:Name="PART_MonthView" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>

                            <!-- Vue année/décennie : trois lignes, quatre colonnes -->
                            <Grid x:Name="PART_YearView" Grid.Row="1"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar n'expose pas de propriété CalendarItemStyle.
         Le CalendarItem est donc stylé dans son ControlTemplate. -->
    <Style x:Key="NFOForgeCalendarStyle"
           TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource CalendarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CalendarForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarBorderBrush}"/>
        <Setter Property="CalendarDayButtonStyle"
                Value="{StaticResource NFOForgeCalendarDayStyle}"/>
        <Setter Property="CalendarButtonStyle"
                Value="{StaticResource NFOForgeCalendarButtonStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <CalendarItem x:Name="PART_CalendarItem"
                                  Style="{StaticResource NFOForgeCalendarItemStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker principal -->
    <Style x:Key="NFOForgeDatePickerStyle"
           TargetType="{x:Type DatePicker}">

        <Setter Property="Background" Value="#101827"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#26374F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type DatePicker}">

                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- Saisie de date -->
                            <DatePickerTextBox
                                x:Name="PART_TextBox"
                                Grid.Column="0"
                                Style="{StaticResource NFOForgeDatePickerTextBoxStyle}"
                                Background="#101827"
                                Foreground="White"
                                VerticalContentAlignment="Center"
                                Margin="1"/>

                            <!-- Bouton du calendrier -->
                            <Button
                                x:Name="PART_Button"
                                Grid.Column="1"
                                Background="#101827"
                                BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand">

                                <TextBlock
                                    Text="▦"
                                    FontSize="19"
                                    Foreground="#00C8FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Button>

                            <!-- Calendrier déroulant -->
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                StaysOpen="False">

                                <Border
                                    Background="#101827"
                                    BorderBrush="#007BFF"
                                    BorderThickness="1">

                                    <Calendar
                                        x:Name="PART_Calendar"
                                        Style="{StaticResource NFOForgeCalendarStyle}"/>

                                </Border>

                            </Popup>

                        </Grid>

                    </Border>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>