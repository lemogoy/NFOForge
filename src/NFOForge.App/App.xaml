<Application x:Class="NFOForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- Palette officielle NFOForge -->
                <ResourceDictionary
                    Source="Themes/Colors.xaml"/>

                <!-- Styles sombres des menus déroulants -->
                <ResourceDictionary
                    Source="Themes/ComboBoxStyles.xaml"/>

                <ResourceDictionary Source="Themes/DatePickerStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>